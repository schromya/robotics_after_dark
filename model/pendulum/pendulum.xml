<mujoco model="pendulum">
    <option timestep="0.002" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global fovy="120" azimuth="140" elevation="-30"/>
    </visual>

    <!-- Fansy cross board groudplane -->
    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
        markrgb="0.8 0.8 0.8" width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    </asset>

    <worldbody>
        <light pos="0 0 2" />
        <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

        <body name="pole" pos="0 0 1">
            <joint name="hinge" type="hinge" axis="0 1 0" damping="0.1" />
            <!-- fromto to specify pos and ori using two point here (0 0 0) and (0 0 -0.5) -->
            <geom type="capsule" fromto="0 0 0 0 0 -0.5" size="0.02" mass="0.1" rgba="0.2 0.4 0.9 1" />
            <geom type="sphere" pos="0 0 -0.5" size="0.05" mass="0.9" rgba="0.9 0.2 0.2 1" />
        </body>
    </worldbody>

    <actuator>
        <motor name="hinge_motor" joint="hinge" ctrlrange="-20 20" /> 
    </actuator>
</mujoco>